<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Edge-to-edge opt-out. It was the official escape hatch while we targeted SDK 35;
         at targetSdk 36 Android 16 IGNORES it and forces edge-to-edge, so the real defence
         is now the WindowInsets listener in MainActivity, which pads the WebView by the
         system bars + display cutout. The attribute stays as a no-op for older targets. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
</resources>
